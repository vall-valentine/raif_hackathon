# Copy to .env and paste your OpenRouter key:
# cp .env.example .env

# Required for OpenRouter calls.
OPENROUTER_API_KEY=sk-or-...

# Optional: override the default model from app/models.py.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# Optional two-stage review. Stage 2 is called only when stage 1 returns real possible_other_groups.
OPENROUTER_TWO_STAGE_ENABLED=true
OPENROUTER_REVIEW_MODEL=anthropic/claude-opus-4.8

# Optional overrides. If omitted or empty, app/models.py uses DEFAULT_* values.
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_TIMEOUT_SECONDS=60
# OPENROUTER_REVIEW_TIMEOUT_SECONDS=60
# OPENROUTER_VERIFY_SSL=false

# Thinking is enabled in the request payload by default.
# OPENROUTER_MAX_TOKENS=2000
# OPENROUTER_THINKING_BUDGET=1500
# OPENROUTER_REVIEW_MAX_TOKENS=1600
# OPENROUTER_REVIEW_THINKING_BUDGET=1200

# Optional OpenRouter provider routing. Azure is ignored by default because it may block these safety eval prompts.
# OPENROUTER_PROVIDER_IGNORE=azure
# OPENROUTER_PROVIDER_ONLY=
# OPENROUTER_PROVIDER_ORDER=
# OPENROUTER_PROVIDER_ALLOW_FALLBACKS=true
# OPENROUTER_PROVIDER_REQUIRE_PARAMETERS=false

# Optional OpenRouter dashboard labels.
# OPENROUTER_APP_NAME=Red Flag Detector
# OPENROUTER_SITE_URL=https://example.com

# Optional custom prompt file.
# RED_FLAG_PROMPT_PATH=app/prompts/red_flag_classifier.md

# Optional train few-shot examples for the stage-2 candidate prompt.
# RED_FLAG_INCLUDE_TRAIN_EXAMPLES=true
# RED_FLAG_TRAIN_EXAMPLES_PATH=app/prompts/train_examples.json
