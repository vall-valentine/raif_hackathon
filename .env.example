# Скопируй в .env и подставь свой ключ: cp .env.example .env
# Ключ OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-opus-4.8
OPENROUTER_TIMEOUT_SECONDS=25

# Необязательно: удобная подпись запросов в OpenRouter dashboard
OPENROUTER_APP_NAME=Red Flag Detector
# OPENROUTER_SITE_URL=https://example.com

# Необязательно: путь к своему prompt-файлу
# RED_FLAG_PROMPT_PATH=app/prompts/red_flag_classifier.md

# HF-режим (опционально): токен Hugging Face для локальной NLI-модели
# HF_TOKEN=hf_...
